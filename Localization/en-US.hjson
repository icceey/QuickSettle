Mods: {
	QuickSettle: {
		LiquidsSettling: Accelerating liquid settlement...
		LiquidsSettled: Flowing liquids have been settled.
		LiquidsAlreadySettling: Liquids are already being settled, please wait...
		LiquidsSettleInterrupted: Settled a large amount of liquids! To ensure smooth gameplay, this task has been paused. Please trigger again if you want to continue.
		Commands: {
			Settle: {
				Description: Immediately settle all flowing liquids in the world.
			}
		}
		Configs: {
			QuickSettleConfig: {
				DisplayName: QuickSettle Config
				EnableTriggerByChat: {
					Label: Send "1" Shortcut
					Tooltip: "When enabled, any player can settle liquids by sending exactly \"1\" in chat. Disabling this only turns off the send-\"1\" shortcut; /settle still works."
				}
			}
		}
	}
}
