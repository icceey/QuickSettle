Mods: {
	QuickSettle: {
		LiquidsSettled: 已结算所有流动中的液体。
		LiquidsSettleAborted: 触发安全熔断后已停止液体结算，当前仍有 {0} 个液体更新待处理。
		Commands: {
			Settle: {
				Description: 立即结算世界中所有流动中的液体。
			}
		}
		Configs: {
			QuickSettleConfig: {
				DisplayName: QuickSettle 配置
				EnableTriggerByChat: {
					Label: 发"1"快捷触发
					Tooltip: "启用后，任何玩家都可以通过在聊天中发送精确的 \"1\" 来结算液体。关闭后仅禁用发送 \"1\" 的快捷触发，/settle 命令仍可使用。"
				}
			}
		}
	}
}
